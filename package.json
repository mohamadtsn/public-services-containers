{
  "name": "pubservices",
  "version": "2.0.0",
  "description": "Shared Docker infrastructure for local development — MySQL, Redis, Nginx, phpMyAdmin, Mailpit, MinIO",
  "keywords": [
    "docker",
    "local-development",
    "mysql",
    "redis",
    "nginx",
    "cli"
  ],
  "homepage": "https://github.com/mohamadtsn/public-services-containers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohamadtsn/public-services-containers.git"
  },
  "license": "MIT",
  "author": "Mohamad Tsn",
  "type": "module",
  "bin": {
    "pubservices": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "commander": "^14.0.3",
    "dotenv": "^17.2.3",
    "ink": "^6.8.0",
    "picocolors": "^1.1.1",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.18",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
